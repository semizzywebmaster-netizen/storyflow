{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__/**",
    "src/**/_1.ts",
    "src/server_1.ts",
    "src/routes/ads.routes.ts",
    "src/routes/advancedAI.routes.ts",
    "src/routes/agency.routes.ts",
    "src/routes/announcement.routes.ts",
    "src/routes/coupon.routes.ts",
    "src/routes/marketplace.routes.ts",
    "src/services/eventIntegration.ts"
  ]
}
