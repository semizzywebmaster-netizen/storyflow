# StoryFlow backend environment variables
# Copy to .env and fill in real values. NEVER commit .env or secrets.

PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/STORYFLOW
JWT_SECRET=generate-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://storyflow.online

# Cloudflare R2 - server-side only
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=storyflow
R2_PUBLIC_URL=https://your-public-r2-domain

# AI Providers - server-side only
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=
FAL_API_KEY=
REPLICATE_API_KEY=
STABILITY_API_KEY=

# Payments - server-side only
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_SECRET_HASH=

# Queue infrastructure (required when async workers are enabled)
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Feature flags
ENABLE_MOCK=false
MASTER_AI_KILL_SWITCH=false

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info

# Optional production PostgreSQL TLS override.
# Keep true (or unset) unless the database provider requires otherwise.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
