# Storyflow frontend environment variables
# Never place API secrets in VITE_* variables; Vite exposes them to the browser.

VITE_API_URL=/api
VITE_ENABLE_MOCK=false
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_APP_NAME=Storyflow
VITE_APP_VERSION=1.0.0

# Production frontend
# https://storyfoundry.online

# If the API is hosted separately, replace VITE_API_URL with the public API base URL,
# for example: https://api.storyfoundry.online/api
